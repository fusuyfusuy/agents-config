# self-test
# --------------------------------------------------------------------------

def _build_fixture(root: Path) -> None:
    (root / "src").mkdir()
    (root / ".agents").mkdir()
    (root / "src" / "core.py").write_text(
        '"""Core engine for the fixture."""\n'
        "class CoreApp:\n"
        "    def run(self, mode: str = 'fast') -> bool:\n"
        "        return True\n"
        "    def _private(self):\n"
        "        pass\n"
        "\n"
        "async def helper(a, b=2, *rest) -> int:\n"
        "    return 0\n"
    )
    (root / "src" / "leaf.py").write_text("def unused_leaf():\n    pass\n")
    tool = root / "bin_tool"
    tool.write_text("#!/usr/bin/env python3\ndef extensionless_main():\n    pass\n")
    tool.chmod(0o755)
    for name in ("one", "two", "three"):
        (root / "src" / f"{name}.py").write_text(f"from src.core import CoreApp\n\ndef {name}():\n    pass\n")
    (root / "src" / "index.ts").write_text(
        "import { CoreApp } from './widget';\nexport function startServer() {}\nexport class Handler {}\n"
    )
    (root / "src" / "widget.ts").write_text("export class Widget {}\n")
    # tsconfig path aliases: the dominant import style in aliased JS/TS projects.
    (root / "tsconfig.json").write_text(
        '{\n  // a comment, because tsconfig is JSONC\n'
        '  "compilerOptions": { "baseUrl": ".", "paths": { "@/*": ["./src/*"] } },\n}\n'
    )
    (root / "src" / "shared.ts").write_text("export const shared = 1;\n")
    app = root / "src" / "app" / "dash"
    app.mkdir(parents=True)
    (app / "page.tsx").write_text(
        'import { shared } from "@/shared";\nimport { Widget } from "@/widget";\n'
        "export default function Page() {}\n"
    )
    (root / "src" / "app" / "layout.tsx").write_text(
        'import { shared } from "@/shared";\nexport default function Layout() {}\n'
    )
    (root / ".agents" / "memory.md").write_text(DEFAULT_MEMORY_TEMPLATE)
    (root / ".agents" / "decisions.md").write_text(DEFAULT_DECISIONS_TEMPLATE)


def _dump_to_string(root: Path) -> str:
    old_cwd = os.getcwd()
    try:
        os.chdir(root)
        buf = io.StringIO()
        with contextlib.redirect_stdout(buf):
            cmd_dump(argparse.Namespace())
        return buf.getvalue()
    finally:
        os.chdir(old_cwd)


def _test_symbols_and_graph(root: Path) -> None:
    content = generate_repo_map(root)

    assert "class CoreApp" in content, "python classes should appear"
    assert "run(mode: str='fast') -> bool" in content, f"signatures must be rendered, got:\n{content}"
    assert "async helper(a, b=2, *rest) -> int" in content, "async + full signature must be rendered"
    assert "_private" not in content, "private methods should be filtered out"
    assert "export function startServer" in content, "generic-language symbols should appear"
    assert '"Core engine for the fixture."' in content, "module docstring should be surfaced"

    core_line = next(l for l in content.splitlines() if l.startswith("`src/core.py`"))
    assert ":2 " in content and ":8 " in content, f"line numbers must be emitted:\n{content}"
    assert "← one, three, two" in core_line, f"in-degree importers must be listed, got: {core_line}"

    assert content.index("src/core.py") < content.index("src/leaf.py"), \
        "imported modules must rank above unimported leaves"
    widget_line = next(l for l in content.splitlines() if l.startswith("`src/widget.ts`"))
    assert "src/index" in widget_line and "dash/page" in widget_line, \
        f"relative and aliased imports must both produce edges, and generic stems must be "\
        f"qualified by their directory, got: {widget_line}"
    assert "extensionless_main" in content, \
        "extensionless executables should be parsed via their shebang"

    shared_line = next(l for l in content.splitlines() if l.startswith("`src/shared.ts`"))
    assert "app/layout" in shared_line and "dash/page" in shared_line, \
        f"tsconfig path aliases (@/x) must produce graph edges, got: {shared_line}"
    assert "export default function Page" in content, \
        "`export default function` (the Next.js page form) must be captured as a symbol"

    entry_block = content.split("## Core modules")[0]
    assert "src/app/dash/page.tsx" in entry_block and "src/app/layout.tsx" in entry_block, \
        "file-system route files should be detected as entry points"
    assert "src/index.ts" not in entry_block, \
        "barrel index files must NOT be treated as entry points"


def _test_budget_is_honest(root: Path) -> None:
    tiny = generate_repo_map(root, budget=400)
    assert "budget" in tiny and "collapsed" in tiny, f"truncation must be announced:\n{tiny}"
    header_total = int(re.search(r"^(\d+) files", tiny, re.M).group(1))
    listed = len(re.findall(r"^`", tiny, re.M))
    assert listed < header_total, "tiny budget should actually reduce detail"
    assert "Detailed" in tiny, "must state how many of the total were detailed"


def _test_git_integration(root: Path) -> None:
    if subprocess.run(["git", "--version"], capture_output=True).returncode != 0:
        print("  (skipped git checks: git unavailable)")
        return

    for cmd in (["init", "-q"], ["config", "user.email", "t@t"], ["config", "user.name", "t"]):
        subprocess.run(["git", "-C", str(root), *cmd], capture_output=True, check=True)
    (root / ".gitignore").write_text("*.jsonl\n!keep/important.jsonl\nlogs/debug.txt\ntmp*\n")
    (root / "keep").mkdir()
    (root / "keep" / "important.jsonl").write_text("{}\n")
    (root / "logs").mkdir()
    (root / "logs" / "debug.txt").write_text("x\n")
    (root / "logs" / "other.txt").write_text("x\n")
    (root / "tmpfile.txt").write_text("x\n")

    files = set(list_files(root))
    assert "keep/important.jsonl" in files, "gitignore negations must be honored"
    assert "logs/debug.txt" not in files, "path-scoped ignore patterns must be honored"
    assert "logs/other.txt" in files, "unignored siblings must survive"
    assert "tmpfile.txt" not in files, "trailing-glob ignore patterns must be honored"

    subprocess.run(["git", "-C", str(root), "add", "-A"], capture_output=True, check=True)
    subprocess.run(["git", "-C", str(root), "commit", "-qm", "fixture commit"], capture_output=True, check=True)
    (root / "src" / "leaf.py").write_text("def unused_leaf():\n    return 1\n")

    subprocess.run(["git", "-C", str(root), "checkout", "-q", "-b", "fixture-branch"], capture_output=True, check=True)
    assert get_git_branch(root) == "fixture-branch", \
        f"branch must be read from git, not assumed, got {get_git_branch(root)!r}"

    subprocess.run(["git", "-C", str(root), "checkout", "--detach", "-q"], capture_output=True, check=True)
    detached = get_git_branch(root)
    assert detached and detached.startswith("detached@"), \
        f"detached HEAD must be reported as detached, not the literal 'HEAD', got {detached!r}"
    subprocess.run(["git", "-C", str(root), "checkout", "-q", "-"], capture_output=True, check=True)

    state = get_working_state(root)
    assert "fixture commit" in state, f"working state must list recent commits:\n{state}"
    assert "src/leaf.py" in state, f"working state must list uncommitted files:\n{state}"

    dump = _dump_to_string(root)
    assert "## Working state" in dump, "dump must include the working-state block"
    assert "fixture commit" in dump, "dump must surface recent commits"


def _test_dump_is_live(root: Path) -> None:
    stale = "STALE_MARKER_SHOULD_NOT_APPEAR"
    (root / ".agents" / "repo_map.md").write_text(f"# Repository Map\n\n{stale}\n")
    (root / "src" / "new_module.py").write_text("def new_function():\n    pass\n")

    dump = _dump_to_string(root)
    assert "new_module.py" in dump, "dump should reflect files added after repo_map.md was cached"
    assert stale not in dump, "dump should not echo stale cached repo_map.md content"


def _test_misc(root: Path) -> None:
    assert get_git_branch(Path(tempfile.gettempdir())) is None, \
        "non-git directories must report no branch, never a fabricated 'main'"

    # Decisions: every title survives; bodies are expanded newest-first.
    adrs = "# Architecture Decisions\n\n" + "\n\n".join(
        f"## ADR-{i:03d}: Decision number {i}\n- **Context**: {'x' * 400}" for i in range(1, 9))
    clipped = clip_decisions(adrs, 1200)
    for i in range(1, 9):
        assert f"ADR-{i:03d}" in clipped, f"every ADR title must survive the trim (missing {i})"
    assert "x" * 400 in clipped, "the newest ADR body should still be expanded"
    assert clipped.count("x" * 400) < 8, "not every body can fit in a 1200-char budget"
    assert "shown by title only" in clipped, "trimming must be announced"
    assert clip_decisions(adrs, 10**6) == adrs, "an ample budget must pass the text through untouched"

    # Memory: priority order, not file order — invariants outrank status.
    mem = ("# Project Memory\n\n"
           "## Active Epics & Tasks\n- " + "e" * 600 + "\n\n"
           "## Core Invariants & Architecture Rules\n- " + "i" * 600 + "\n\n"
           "## Domain Vocabulary & Gotchas\n- " + "g" * 600 + "\n")
    trimmed = clip_memory(mem, 900)
    assert "i" * 600 in trimmed, "invariants must be kept ahead of status sections"
    assert "e" * 600 not in trimmed, "the epics/status section must be trimmed first"
    assert "Active Epics" in trimmed, "a trimmed section must still be listed by heading"
    assert "trimmed" in trimmed, "trimming must be announced"

    # The top-priority section must survive even when it alone exceeds the budget —
    # a greedy fill would drop it and backfill with smaller, less important sections.
    fat = ("# Project Memory\n\n"
           "## Active Epics & Tasks\n- " + "e" * 200 + "\n\n"
           "## Core Invariants & Architecture Rules\n" +
           "\n".join(f"- invariant {i} " + "i" * 60 for i in range(40)) + "\n")
    squeezed = clip_memory(fat, 1500)
    assert "invariant 0" in squeezed, "the highest-priority section must appear even if oversized"
    assert "truncated to budget" in squeezed, "a partially included section must say so"
    assert "e" * 200 not in squeezed, "lower-priority sections must not displace invariants"

    # Superseded ADRs are never expanded, even when the budget is ample.
    sup = ("# Architecture Decisions\n\n"
           "## ADR-001: Old way\n- **Context**: " + "o" * 300 + "\n- **Superseded by**: ADR-002\n\n"
           "## ADR-002: New way\n- **Context**: " + "n" * 300 + "\n")
    got = clip_decisions(sup, 10**6)
    assert "ADR-001" in got and "ADR-002" in got, "both titles must remain visible"
    assert "n" * 300 in got, "the live ADR body must be expanded"
    assert "o" * 300 not in got, "a superseded ADR body must never be expanded"
    assert "superseded" in got, "supersession must be announced"

    # The shipped decisions template must not itself parse as an ADR.
    _, tpl_sections = _split_sections(DEFAULT_DECISIONS_TEMPLATE)
    assert not tpl_sections, "the decisions template must contain no phantom ADR heading"

    assert resolve_budget(None, 24000) == 24000, "no flag means the command default"
    assert resolve_budget(None, MAP_BUDGET_DEFAULT) == UNLIMITED, "map defaults to a complete map"
    assert resolve_budget("unlimited", 24000) == UNLIMITED, "'unlimited' must resolve"
    assert resolve_budget("large", 24000) == BUDGET_PRESETS["large"], "preset names must resolve"
    assert resolve_budget("5000", 24000) == 5000, "raw character counts must resolve"


def run_self_test() -> int:
    with tempfile.TemporaryDirectory() as tmpdir:
        root = Path(tmpdir).resolve()
        _build_fixture(root)
        _test_symbols_and_graph(root)
        _test_budget_is_honest(root)
        _test_misc(root)
        _test_git_integration(root)
        _test_dump_is_live(root)
    print("Self-test passed successfully.")
    return 0


def main() -> int:
    parser = argparse.ArgumentParser(description="Zero-daemon Agent Context, Memory, & Activity Tracker")
    parser.add_argument("--test", action="store_true", help="Run self-tests and exit")
    subparsers = parser.add_subparsers(dest="command", help="Sub-command to execute")

    subparsers.add_parser("init", help="Initialize .agents/ directory with templates and repo map")

    map_parser = subparsers.add_parser("map", help="Scan repository and generate ranked symbol map")
    map_parser.add_argument("--stdout", action="store_true", help="Print map to stdout instead of file")
    budget_help = (f"Character budget: a number, 'default', or {'/'.join(BUDGET_PRESETS)} "
                   f"({', '.join(f'{k}={v}' for k, v in BUDGET_PRESETS.items())}). "
                   f"Env: AGENT_CTX_BUDGET.")
    map_parser.add_argument("--budget", default=None, help=budget_help)

    dump_parser = subparsers.add_parser(
        "dump", help="Print high-signal context snapshot (state, memory, decisions, map, activity)")
    dump_parser.add_argument("--budget", default=None, help=budget_help)

    log_parser = subparsers.add_parser("log", help="Append an entry to .agents/activity.jsonl")
    log_parser.add_argument("--action", required=True, help="Short action name (e.g. 'feature-auth')")
    log_parser.add_argument("--summary", required=True, help="Detailed summary of change and rationale")
    log_parser.add_argument("--files", default="", help="Comma-separated list of modified files")

    hist_parser = subparsers.add_parser("history", help="Show recent logged agent actions")
    hist_parser.add_argument("--limit", type=int, default=10, help="Number of records to show (default: 10)")

    args = parser.parse_args()

    if args.test:
        return run_self_test()

    if not args.command:
        parser.print_help()
        return 1

    handlers = {
        "init": cmd_init,
        "map": cmd_map,
        "dump": cmd_dump,
        "log": cmd_log,
        "history": cmd_history,
    }
    return handlers[args.command](args)


if __name__ == "__main__":
    sys.exit(main())
