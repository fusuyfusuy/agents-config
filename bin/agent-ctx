#!/usr/bin/env python3
"""agent-ctx: Zero-daemon Agent Context, Memory, Repo Mapping & Activity Tracking CLI.

Zero external dependencies - Python standard library only.
"""

from __future__ import annotations

import argparse
import ast
import contextlib
import datetime
import io
import json
import os
import re
import subprocess
import sys
import tempfile
import tomllib
from pathlib import Path
from typing import Dict, List, Optional, Set, Tuple

# Used only when the repo is not a git checkout; inside git, `git ls-files` is
# the authority on what is visible (it implements .gitignore correctly).
DEFAULT_IGNORES = {
    ".git", ".venv", "venv", "node_modules", "__pycache__", "dist", "build",
    "target", ".pytest_cache", ".mypy_cache", ".ruff_cache", "coverage",
    ".idea", ".vscode", ".next", ".turbo", ".gemini", ".antigravity",
}

CODE_EXTS = {".py", ".js", ".jsx", ".ts", ".tsx", ".go", ".rs", ".c", ".cpp", ".h"}
JS_EXTS = (".ts", ".tsx", ".js", ".jsx")
# Deliberately excludes index.{ts,js}: those are usually barrel re-export hubs, the
# opposite of an entry point. A real package entry is declared in package.json and
# picked up by detect_entry_points instead.
ENTRY_NAMES = {
    "main.py", "__main__.py", "app.py", "cli.py", "manage.py", "server.py",
    "main.go", "main.rs",
}
# Next.js / Remix style file-system routing: these *are* the app's entry points.
ROUTE_STEMS = {"page", "layout", "route"}

# `map` writes a file / stdout for browsing, not context, so it is complete by
# default. Real repos cost ~40 tokens per file, so a full map is affordable up to
# a few hundred files; `--budget` caps it when that stops being true.
UNLIMITED = 10**9
MAP_BUDGET_DEFAULT = UNLIMITED
# `dump` spends its budget in priority order: memory and decisions are hand-written
# and cannot be recovered from the code, so they are served first; the map is
# derivable and re-queryable with Grep, so it absorbs whatever is left.
DUMP_TOTAL_BUDGET = 24000
DUMP_MAP_MIN_BUDGET = 4000
# Presets are absolute character budgets (~4 chars per token). Raising the budget
# costs tokens, not time — generation is flat regardless — and buys progressively
# less: the map saturates at a size set by the repo, after which more budget adds
# nothing. Measured on real repos the full map runs ~40 tokens/file, so "unlimited"
# is cheap into the hundreds of files and untenable in the thousands. `dump` still
# defaults to DUMP_TOTAL_BUDGET because it spends context, not disk.
BUDGET_PRESETS = {"large": 60_000, "immense": 200_000, "unlimited": UNLIMITED}
COLLAPSE_RESERVE = 1200  # room for the collapsed-dirs tail, so it stays inside the budget
MAX_PARSE_BYTES = 500_000
CHURN_DAYS = 90

DEFAULT_MEMORY_TEMPLATE = """# Project Memory

## Active Epics & Tasks
- (Add active high-level tasks or milestones here)

## Core Invariants & Architecture Rules
- (Add non-negotiable architecture decisions and constraints here)

## Domain Vocabulary & Gotchas
- (Add known edge-cases, quirks, or domain terms here)
"""

DEFAULT_DECISIONS_TEMPLATE = """# Architecture Decisions (ADRs)

<!--
Record format - one `## ` heading per decision, newest appended last:

## [YYYY-MM-DD] ADR-Title
- **Context**: Why was this decision necessary?
- **Decision**: What was chosen?
- **Consequences**: What trade-offs or constraints follow?
- **Superseded by**: optional. Name the ADR that replaced this one. Superseded
  entries stay in the file for history but are never expanded in `agent-ctx
  dump` - they are listed by title only, so the file can grow without the
  snapshot growing with it.

This block is an HTML comment on purpose: a `## ` heading here would be parsed
as an ADR and render as a phantom entry in every dump.
-->
"""


# --------------------------------------------------------------------------
# repo root & git
# --------------------------------------------------------------------------

def find_repo_root(start: Optional[Path] = None) -> Path:
    curr = (start or Path.cwd()).resolve()
    for parent in [curr] + list(curr.parents):
        if (parent / ".git").exists() or (parent / ".agents").exists():
            return parent
    return curr


def run_git(root: Path, *args: str, timeout: int = 5) -> Optional[str]:
    """Run a git command in `root`. Returns stdout, or None if git/repo is unavailable."""
    try:
        res = subprocess.run(
            ["git", "-C", str(root), *args],
            capture_output=True, text=True, timeout=timeout, check=False,
        )
    except Exception:
        return None
    if res.returncode != 0:
        return None
    return res.stdout


def get_git_branch(root: Path) -> Optional[str]:
    """Current branch name, "detached@<sha>" on detached HEAD, or None outside git.

    Never guesses a branch name: a fabricated value would be written into the
    permanent activity log.
    """
    out = run_git(root, "rev-parse", "--abbrev-ref", "HEAD", timeout=2)
    if out is None or not out.strip():
        return None
    branch = out.strip()
    if branch == "HEAD":
        sha = run_git(root, "rev-parse", "--short", "HEAD", timeout=2)
        return f"detached@{sha.strip()}" if sha and sha.strip() else "detached"
    return branch


def should_ignore(rel_path: Path) -> bool:
    return any(part in DEFAULT_IGNORES for part in rel_path.parts)


def list_files(root: Path) -> List[str]:
    """Repo-visible files as posix-relative strings.

    Delegates to `git ls-files` so .gitignore semantics (negations, path-scoped
    patterns, globs) are git's problem, not ours. Falls back to a walk with a
    fixed ignore list outside git checkouts.
    """
    out = run_git(root, "ls-files", "--cached", "--others", "--exclude-standard", "-z", timeout=15)
    if out is not None:
        rels = {p for p in out.split("\0") if p}
        return sorted(r for r in rels if (root / r).is_file())

    found = []
    for dirpath, dirnames, filenames in os.walk(root):
        rel_dir = Path(dirpath).relative_to(root)
        dirnames[:] = [d for d in dirnames if not should_ignore(rel_dir / d)]
        for f in filenames:
            rel = rel_dir / f if rel_dir != Path(".") else Path(f)
            if not should_ignore(rel) and not f.endswith(".pyc"):
                found.append(rel.as_posix())
    return sorted(found)


def get_churn(root: Path, days: int = CHURN_DAYS) -> Dict[str, int]:
    """Commits touching each file in the recent window. Empty dict outside git."""
    out = run_git(root, "log", f"--since={days}.days", "-n", "400", "--name-only",
                  "--pretty=format:", timeout=10)
    if not out:
        return {}
    counts: Dict[str, int] = {}
    for line in out.splitlines():
        line = line.strip()
        if line:
            counts[line] = counts.get(line, 0) + 1
    return counts


def get_working_state(root: Path) -> Optional[str]:
    """Branch, uncommitted files and recent commits — what a resuming agent needs first."""
    branch = get_git_branch(root)
    if branch is None:
        return None

    lines = [f"- branch: `{branch}`"]

    status = run_git(root, "status", "--porcelain")
    dirty = [l for l in (status or "").splitlines() if l.strip()]
    if dirty:
        lines.append(f"- uncommitted ({len(dirty)}):")
        for entry in dirty[:10]:
            lines.append(f"    - `{entry.strip()}`")
        if len(dirty) > 10:
            lines.append(f"    - ... and {len(dirty) - 10} more")
    else:
        lines.append("- uncommitted: none (clean tree)")

    log = run_git(root, "log", "-5", "--oneline", "--no-decorate")
    if log and log.strip():
        lines.append("- recent commits:")
        for entry in log.strip().splitlines():
            lines.append(f"    - {entry}")
    return "\n".join(lines)


# --------------------------------------------------------------------------
# file analysis
# --------------------------------------------------------------------------

class FileInfo:
    """One repo file: its symbols, its imports, and the signals used to rank it."""

    def __init__(self, path: str, size: int):
        self.path = path
        self.size = size
        self.lines = 0
        self.doc: Optional[str] = None
        self.symbols: List[Tuple[int, int, str]] = []  # (lineno, depth, text)
        self.imports: List[tuple] = []
        self.importers: Set[str] = set()
        self.churn = 0
        self.entry = False
        self.executable = False

    @property
    def in_degree(self) -> int:
        return len(self.importers)

    @property
    def score(self) -> int:
        return (4 * self.in_degree) + min(self.churn, 10) + (6 if self.entry else 0) + (1 if self.symbols else 0)


def _elide(text: str, limit: int) -> str:
    """Truncate visibly, so a cut signature never reads as a complete one."""
    return text if len(text) <= limit else text[:limit - 1] + "…"


def _fmt_signature(node, drop_self: bool) -> str:
    try:
        params = ast.unparse(node.args)
    except Exception:
        params = "..."
    if drop_self:
        for prefix in ("self, ", "cls, "):
            if params.startswith(prefix):
                params = params[len(prefix):]
                break
        if params in ("self", "cls"):
            params = ""
    sig = f"{node.name}({params})"
    if node.returns is not None:
        with contextlib.suppress(Exception):
            sig += f" -> {ast.unparse(node.returns)}"
    prefix = "async " if isinstance(node, ast.AsyncFunctionDef) else ""
    return _elide(prefix + sig, 88)


def _first_doc_line(node) -> Optional[str]:
    try:
        doc = ast.get_docstring(node)
    except Exception:
        return None
    if not doc:
        return None
    return doc.strip().splitlines()[0].strip()[:100]


def parse_python(content: str) -> Tuple[Optional[str], List[Tuple[int, int, str]], List[tuple]]:
    """Symbols with signatures + line numbers, plus import specs for the graph."""
    symbols: List[Tuple[int, int, str]] = []
    imports: List[tuple] = []
    try:
        tree = ast.parse(content)
    except Exception:
        # Unparseable (syntax error, different python dialect): degrade to names only.
        for i, line in enumerate(content.splitlines(), 1):
            m = re.match(r"^(?:class|def|async def)\s+([A-Za-z0-9_]+)", line.strip())
            if m:
                symbols.append((i, 0, m.group(0)))
        return None, symbols, imports

    for node in ast.walk(tree):
        if isinstance(node, ast.Import):
            imports.extend(("py_abs", a.name) for a in node.names)
        elif isinstance(node, ast.ImportFrom):
            if node.level:
                if node.module:
                    imports.append(("py_rel", node.level, node.module))
                else:
                    imports.extend(("py_rel", node.level, a.name) for a in node.names)
            elif node.module:
                imports.append(("py_abs", node.module))

    for node in tree.body:
        if isinstance(node, ast.ClassDef):
            symbols.append((node.lineno, 0, f"class {node.name}"))
            for sub in node.body:
                if isinstance(sub, (ast.FunctionDef, ast.AsyncFunctionDef)):
                    if sub.name.startswith("_") and sub.name != "__init__":
                        continue
                    symbols.append((sub.lineno, 1, _fmt_signature(sub, drop_self=True)))
        elif isinstance(node, (ast.FunctionDef, ast.AsyncFunctionDef)):
            symbols.append((node.lineno, 0, _fmt_signature(node, drop_self=False)))

    return _first_doc_line(tree), symbols, imports


GENERIC_PATTERNS = {
    ".js": [r"^(?:export\s+)?(?:default\s+)?(?:async\s+)?(?:function|class)\s+([A-Za-z0-9_$]+)",
            r"^export\s+const\s+([A-Za-z0-9_$]+)"],
    ".jsx": [r"^(?:export\s+)?(?:default\s+)?(?:async\s+)?(?:function|class)\s+([A-Za-z0-9_$]+)",
             r"^export\s+const\s+([A-Za-z0-9_$]+)"],
    ".ts": [r"^(?:export\s+)?(?:default\s+)?(?:async\s+)?(?:function|class|interface|type|enum)\s+([A-Za-z0-9_$]+)",
            r"^export\s+const\s+([A-Za-z0-9_$]+)"],
    ".tsx": [r"^(?:export\s+)?(?:default\s+)?(?:async\s+)?(?:function|class|interface|type|enum)\s+([A-Za-z0-9_$]+)",
             r"^export\s+const\s+([A-Za-z0-9_$]+)"],
    ".go": [r"^func\s+(?:\([^\)]+\)\s+)?([A-Za-z0-9_]+)", r"^type\s+([A-Za-z0-9_]+)\s+(?:struct|interface)"],
    ".rs": [r"^(?:pub\s+)?(?:fn|struct|enum|trait|type)\s+([A-Za-z0-9_]+)"],
    ".c": [r"^[A-Za-z0-9_ *]+\s+([A-Za-z0-9_]+)\s*\([^)]*\)\s*\{"],
    ".cpp": [r"^(?:class|struct)\s+([A-Za-z0-9_]+)", r"^[A-Za-z0-9_ *:]+\s+([A-Za-z0-9_]+)\s*\([^)]*\)\s*\{"],
    ".h": [r"^(?:class|struct)\s+([A-Za-z0-9_]+)", r"^[A-Za-z0-9_ *:]+\s+([A-Za-z0-9_]+)\s*\([^)]*\);"],
}

JS_IMPORT_RE = re.compile(r"""(?:from|require\()\s*['"]([^'"]+)['"]""")


def parse_generic(content: str, ext: str) -> Tuple[Optional[str], List[Tuple[int, int, str]], List[tuple]]:
    symbols: List[Tuple[int, int, str]] = []
    imports: List[tuple] = []
    regexes = [re.compile(p) for p in GENERIC_PATTERNS.get(ext, [])]

    for i, raw in enumerate(content.splitlines(), 1):
        line = raw.strip()
        if ext in JS_EXTS:
            # Keep bare specifiers too: they may be tsconfig path aliases (`@/lib/x`),
            # which in an aliased project vastly outnumber relative imports.
            imports.extend(("js_spec", spec) for spec in JS_IMPORT_RE.findall(line))
        for c in regexes:
            if c.match(line):
                symbols.append((i, 0, _elide(line.rstrip("{ ").strip(), 88)))
                break
    return None, symbols, imports


SHEBANG_EXTS = {"python": ".py", "node": ".js", "deno": ".ts", "bun": ".ts"}


def _sniff_shebang(full: Path) -> Optional[str]:
    """Map an extensionless script to a parser via its shebang."""
    try:
        with open(full, "rb") as f:
            first = f.readline(200).decode("utf-8", errors="ignore")
    except OSError:
        return None
    if not first.startswith("#!"):
        return None
    for name, ext in SHEBANG_EXTS.items():
        if name in first:
            return ext
    return None


def analyze_file(root: Path, rel: str) -> Optional[FileInfo]:
    full = root / rel
    try:
        st = full.stat()
    except OSError:
        return None
    info = FileInfo(rel, st.st_size)
    info.executable = bool(st.st_mode & 0o111)

    ext = Path(rel).suffix.lower()
    if ext not in CODE_EXTS and info.executable:
        ext = _sniff_shebang(full) or ext  # extensionless scripts in bin/ are common
    if ext not in CODE_EXTS or st.st_size > MAX_PARSE_BYTES:
        return info

    try:
        content = full.read_text(encoding="utf-8", errors="ignore")
    except OSError:
        return info

    info.lines = content.count("\n") + 1
    if ext == ".py":
        info.doc, info.symbols, info.imports = parse_python(content)
    else:
        info.doc, info.symbols, info.imports = parse_generic(content, ext)
    return info


# --------------------------------------------------------------------------
# import graph
# --------------------------------------------------------------------------

def build_python_index(paths: Set[str]) -> Dict[str, Set[str]]:
    """Map every dotted-path suffix of each module to the file(s) providing it.

    So `backend/db.py` is reachable as "db", "backend.db", ... which lets an
    `from backend.db import X` in a src-layout project resolve without knowing
    where sys.path would have started.
    """
    index: Dict[str, Set[str]] = {}
    for path in paths:
        if not path.endswith(".py"):
            continue
        parts = path[:-3].split("/")
        if parts[-1] == "__init__":
            parts = parts[:-1]
        if not parts:
            continue
        for i in range(len(parts)):
            index.setdefault(".".join(parts[i:]), set()).add(path)
    return index


def _resolve_py_module(module: str, index: Dict[str, Set[str]]) -> Optional[str]:
    hits = index.get(module)
    if hits and len(hits) == 1:  # ambiguous names would create false edges
        return next(iter(hits))
    return None


_JSONC_RE = re.compile(r'"(?:\\.|[^"\\])*"|//[^\n]*|/\*.*?\*/', re.S)


def _load_jsonc(path: Path) -> dict:
    """Parse JSON that may carry comments/trailing commas (tsconfig.json does)."""
    raw = path.read_text(encoding="utf-8", errors="ignore")
    try:
        return json.loads(raw)
    except Exception:
        pass
    stripped = _JSONC_RE.sub(lambda m: m.group(0) if m.group(0).startswith('"') else "", raw)
    return json.loads(re.sub(r",\s*([}\]])", r"\1", stripped))


def load_path_aliases(root: Path, paths: Set[str]) -> List[Tuple[str, List[str]]]:
    """(prefix, [target dirs]) from tsconfig/jsconfig `compilerOptions.paths`.

    Without this, an aliased project's import graph is nearly empty: in a typical
    Next.js repo `@/...` imports outnumber relative ones by more than 10:1.
    """
    aliases: List[Tuple[str, List[str]]] = []
    for cfg in ("tsconfig.json", "jsconfig.json"):
        if cfg not in paths:
            continue
        try:
            opts = _load_jsonc(root / cfg).get("compilerOptions") or {}
        except Exception:
            continue
        base_dir = os.path.normpath(str(opts.get("baseUrl") or "."))
        for pattern, targets in (opts.get("paths") or {}).items():
            prefix = pattern.replace("*", "")
            if not prefix:
                continue
            dirs = [os.path.normpath(f"{base_dir}/{str(t).replace('*', '')}") for t in targets]
            aliases.append((prefix, dirs))
    return aliases


def _try_candidates(norm: str, paths: Set[str]) -> Optional[str]:
    if norm.startswith(".."):
        return None
    for cand in [norm] + [norm + e for e in JS_EXTS] + [f"{norm}/index{e}" for e in JS_EXTS]:
        if cand in paths:
            return cand
    return None


def _resolve_rel_path(source: str, spec: str, paths: Set[str]) -> Optional[str]:
    try:
        norm = os.path.normpath((Path(source).parent / spec).as_posix())
    except Exception:
        return None
    return _try_candidates(norm, paths)


def _resolve_alias(spec: str, aliases: List[Tuple[str, List[str]]], paths: Set[str]) -> Optional[str]:
    for prefix, dirs in aliases:
        if not spec.startswith(prefix):
            continue
        rest = spec[len(prefix):]
        for target_dir in dirs:
            hit = _try_candidates(os.path.normpath(f"{target_dir}/{rest}"), paths)
            if hit:
                return hit
    return None


def build_import_graph(infos: Dict[str, FileInfo], py_index: Dict[str, Set[str]],
                       aliases: List[Tuple[str, List[str]]]) -> None:
    """Populate `importers` so in-degree can rank structurally central modules.

    ponytail: resolves Python (via ast) and relative JS/TS specifiers only. Go
    and Rust get symbols and churn ranking but no edges — a guessy resolver
    would inject false edges, and wrong ranking is worse than absent ranking.
    """
    paths = set(infos)
    for source, info in infos.items():
        for spec in info.imports:
            target = None
            if spec[0] == "py_abs":
                target = _resolve_py_module(spec[1], py_index)
            elif spec[0] == "py_rel":
                _, level, module = spec
                base = Path(source).parent
                for _ in range(level - 1):
                    base = base.parent
                stem = (base / module.replace(".", "/")).as_posix().lstrip("./")
                for cand in (f"{stem}.py", f"{stem}/__init__.py"):
                    if cand in paths:
                        target = cand
                        break
            elif spec[0] == "js_spec":
                js_spec = spec[1]
                target = (_resolve_rel_path(source, js_spec, paths) if js_spec.startswith(".")
                          else _resolve_alias(js_spec, aliases, paths))

            if target and target != source:
                infos[target].importers.add(source)


# --------------------------------------------------------------------------
# entry points
# --------------------------------------------------------------------------

def detect_entry_points(root: Path, infos: Dict[str, FileInfo], py_index: Dict[str, Set[str]]) -> None:
    for rel, info in infos.items():
        parts = rel.split("/")
        # An executable file counts as an entry point only near the surface of the
        # repo or under bin/. Deep executables are usually helper scripts sourced by
        # something else, and labelling them "entry point" is noise.
        shallow = len(parts) <= 2 or "bin" in parts[:-1]
        stem, ext = os.path.splitext(parts[-1])
        routed = ext in JS_EXTS and (
            stem == "middleware" or (stem in ROUTE_STEMS and {"app", "pages"} & set(parts[:-1]))
        )
        if parts[-1] in ENTRY_NAMES or routed or (info.executable and shallow):
            info.entry = True

    for rel in list(infos):
        name = rel.rsplit("/", 1)[-1]
        try:
            if name == "pyproject.toml":
                data = tomllib.loads((root / rel).read_text(encoding="utf-8", errors="ignore"))
                targets = (data.get("project", {}).get("scripts") or {}).values()
                for target in targets:
                    hit = _resolve_py_module(str(target).split(":")[0], py_index)
                    if hit:
                        infos[hit].entry = True
            elif name == "package.json":
                data = json.loads((root / rel).read_text(encoding="utf-8", errors="ignore"))
                base = Path(rel).parent
                raw = data.get("bin") or {}
                targets = list(raw.values()) if isinstance(raw, dict) else [raw]
                if data.get("main"):
                    targets.append(data["main"])
                for target in targets:
                    cand = os.path.normpath((base / str(target)).as_posix())
                    if cand in infos:
                        infos[cand].entry = True
        except Exception:
            continue


# --------------------------------------------------------------------------
# repo map rendering
# --------------------------------------------------------------------------

def collect_repo(root: Path) -> Dict[str, FileInfo]:
    infos: Dict[str, FileInfo] = {}
    for rel in list_files(root):
        info = analyze_file(root, rel)
        if info is not None:
            infos[rel] = info

    py_index = build_python_index(set(infos))
    build_import_graph(infos, py_index, load_path_aliases(root, set(infos)))
    detect_entry_points(root, infos, py_index)
    for rel, count in get_churn(root).items():
        if rel in infos:
            infos[rel].churn = count
    return infos


def _render_symbol(lineno: int, depth: int, text: str) -> str:
    return f"  :{str(lineno).ljust(5)}{'  ' * depth}{text}"


GENERIC_STEMS = {"index", "page", "layout", "route", "main", "mod", "__init__"}


def _importer_label(path: str) -> str:
    """Name an importing file. Bare stems collide in route-based projects, where
    a dozen distinct files are all called `page` — qualify those with their dir."""
    p = Path(path)
    if p.stem in GENERIC_STEMS and p.parent.name:
        return f"{p.parent.name}/{p.stem}"
    return p.stem


def _file_header(info: FileInfo) -> str:
    bits = []
    if info.lines:
        bits.append(f"{info.lines} ln")
    if info.importers:
        names = sorted({_importer_label(p) for p in info.importers})
        shown = ", ".join(names[:4])
        if len(names) > 4:
            shown += f", +{len(names) - 4}"
        bits.append(f"← {shown}")
    if info.churn:
        bits.append(f"{info.churn} commit{'s' if info.churn != 1 else ''}/{CHURN_DAYS}d")
    if info.entry:
        bits.append("entry point")
    suffix = f" · {' · '.join(bits)}" if bits else ""
    return f"`{info.path}`{suffix}"


def _render_detail(info: FileInfo) -> str:
    out = [_file_header(info)]
    if info.doc:
        out.append(f'  "{info.doc}"')
    for lineno, depth, text in info.symbols[:12]:
        out.append(_render_symbol(lineno, depth, text))
    if len(info.symbols) > 12:
        out.append(f"  ... +{len(info.symbols) - 12} more symbols")
    return "\n".join(out)


def _render_compact(info: FileInfo) -> str:
    tops = [f":{ln} {txt.split('(')[0]}" for ln, depth, txt in info.symbols if depth == 0][:6]
    tail = f" · {' · '.join(tops)}" if tops else ""
    return f"{_file_header(info)}{tail}"


def _group_dirs(infos: List[FileInfo], top_level_only: bool) -> List[str]:
    groups: Dict[str, List[FileInfo]] = {}
    for info in infos:
        parent = Path(info.path).parent
        key = (parent.parts[0] if top_level_only and parent.parts else parent.as_posix())
        groups.setdefault("." if key == "." else key.rstrip("/") + "/", []).append(info)

    out = []
    for parent in sorted(groups):
        members = groups[parent]
        exts = sorted({Path(m.path).suffix or "(no ext)" for m in members})
        if len(members) <= 3 and not top_level_only:
            out.append(f"- `{parent}` — " + ", ".join(f"`{Path(m.path).name}`" for m in members))
        else:
            out.append(f"- `{parent}` — {len(members)} files ({', '.join(exts[:4])})")
    return out


def _collapse_dirs(infos: List[FileInfo], limit: int) -> List[str]:
    """Summarise collapsed files, rolling up to top-level dirs if the list is itself
    too long — an unbudgeted tail would quietly blow the caller's budget."""
    lines = _group_dirs(infos, top_level_only=False)
    if sum(len(l) + 1 for l in lines) <= limit:
        return lines
    return _group_dirs(infos, top_level_only=True)


def generate_repo_map(root: Path, budget: int = MAP_BUDGET_DEFAULT) -> str:
    infos = collect_repo(root)
    total = len(infos)
    total_lines = sum(i.lines for i in infos.values())

    ranked = sorted(infos.values(), key=lambda i: (-i.score, i.path))
    head = [
        "# Repository Map",
        "",
        f"{total} files · {total_lines} lines of parsed code · "
        f"ranked by import in-degree + {CHURN_DAYS}d churn + entry points",
    ]

    entries = [i for i in ranked if i.entry]
    if entries:
        head += ["", "## Entry points", ""]
        head += [f"- `{i.path}`" for i in entries[:10]]
        if len(entries) > 10:
            head.append(f"- _... +{len(entries) - 10} more entry points (ranked; see the map below)_")

    core_blocks: List[str] = []
    support_blocks: List[str] = []
    collapsed: List[FileInfo] = []
    detailed = 0
    used = sum(len(l) + 1 for l in head)
    truncated = False

    for info in ranked:
        # A widely-imported file earns a line even with no parsed symbols — its
        # importer list is the point, and losing it to the collapsed bucket hides
        # exactly the kind of shared module the ranking exists to surface.
        if not info.symbols and info.in_degree < 2:
            collapsed.append(info)
            continue
        is_core = info.entry or info.in_degree >= 2
        block = _render_detail(info) if is_core else _render_compact(info)
        if truncated or used + len(block) + 2 > budget - COLLAPSE_RESERVE:
            truncated = True
            collapsed.append(info)
            continue
        used += len(block) + 2
        (core_blocks if is_core else support_blocks).append(block)
        detailed += 1

    out = list(head)
    if core_blocks:
        out += ["", "## Core modules", ""]
        out.append("\n\n".join(core_blocks))
    if support_blocks:
        out += ["", "## Supporting files", ""]
        out.append("\n\n".join(support_blocks))
    if collapsed:
        out += ["", "## Other files", ""]
        out += _collapse_dirs(collapsed, COLLAPSE_RESERVE)

    out += ["", f"_Detailed {detailed} of {total} files; {len(collapsed)} collapsed above._"]
    if truncated:
        out.append(
            f"_Output hit the {budget}-char budget — lower-ranked files were collapsed, "
            f"not dropped. Raise with `agent-ctx map --budget N`, or use Grep for exact locations._"
        )
    return "\n".join(out)


# --------------------------------------------------------------------------
# commands
# --------------------------------------------------------------------------

def _split_sections(text: str) -> Tuple[str, List[Tuple[str, str]]]:
    """Split markdown into (preamble, [(heading, body)]) at its dominant heading level.

    The level is detected rather than assumed: real files disagree with the template
    (titirek writes `## ADR-001: ...`, this repo writes `### [date] Title`).
    """
    lines = text.splitlines()
    # A heading inside an HTML comment is documentation, not a record: the shipped
    # templates show the record format that way, and it must not parse as an entry.
    visible, in_comment = [], False
    for line in lines:
        visible.append(not in_comment)
        if "<!--" in line and "-->" not in line:
            in_comment = True
        elif in_comment and "-->" in line:
            in_comment = False

    counts = {lv: sum(1 for i, l in enumerate(lines)
                      if visible[i] and re.match(rf"^#{{{lv}}}\s+\S", l)) for lv in (2, 3, 4)}
    level = max(counts, key=lambda lv: (counts[lv], -lv))
    if counts[level] == 0:
        return text, []

    pat = re.compile(rf"^#{{{level}}}\s+\S")
    preamble: List[str] = []
    sections: List[List] = []
    for i, line in enumerate(lines):
        if visible[i] and pat.match(line):
            sections.append([line, []])
        elif sections:
            sections[-1][1].append(line)
        else:
            preamble.append(line)
    return "\n".join(preamble).strip(), [(h, "\n".join(b).rstrip()) for h, b in sections]


def _is_superseded(section: Tuple[str, str]) -> bool:
    """An ADR that names its replacement is history, not current guidance."""
    heading, body = section
    return "superseded by" in body.lower() or "[superseded]" in heading.lower()


def clip_decisions(text: str, limit: int) -> str:
    """Keep every ADR *title*, expand bodies newest-first until the budget runs out.

    Positional clipping is wrong for ADRs: they are not news, and the oldest entries
    are usually the load-bearing invariants. Titles cost ~60 chars each, so the full
    list of decisions stays visible indefinitely and any body can still be read from
    the file.
    """
    preamble, sections = _split_sections(text)
    if not sections:
        return text

    live = [i for i in range(len(sections)) if not _is_superseded(sections[i])]
    if len(live) == len(sections) and len(text) <= limit:
        return text

    used = len(preamble) + sum(len(h) + 2 for h, _ in sections) + 160
    expanded = set()
    for idx in reversed(live):  # newest live entries are appended last
        body = sections[idx][1]
        if used + len(body) + 2 > limit:
            continue
        used += len(body) + 2
        expanded.add(idx)

    out = [preamble] if preamble else []
    for idx, (heading, body) in enumerate(sections):
        if idx in expanded:
            out.append(f"{heading}\n{body}".rstrip())
        elif idx not in live:
            out.append(f"{heading}\n- _(superseded — kept for history, read `.agents/decisions.md`)_")
        else:
            out.append(f"{heading}\n- _(body trimmed to budget — read `.agents/decisions.md`)_")
    hidden = len(sections) - len(expanded)
    if hidden:
        superseded = len(sections) - len(live)
        note = f"_{hidden} of {len(sections)} decisions shown by title only"
        if superseded:
            note += f" ({superseded} superseded)"
        out.append(note + "; no decision is hidden entirely._")
    return "\n\n".join(out)


MEMORY_PRIORITY = (
    ("invariant", "rule", "architecture", "constraint"),
    ("gotcha", "vocab", "domain", "glossar", "edge"),
)


def _memory_priority(heading: str) -> int:
    low = heading.lower()
    for rank, keywords in enumerate(MEMORY_PRIORITY):
        if any(k in low for k in keywords):
            return rank
    return len(MEMORY_PRIORITY)  # epics/status: the most perishable, trimmed first


def clip_memory(text: str, limit: int) -> str:
    """Trim by section priority, not file position.

    Invariants and gotchas outlive "active epics", but epics sit first in the
    template — clipping from the top keeps the changelog and drops the durable rules.
    """
    preamble, sections = _split_sections(text)
    if not sections or len(text) <= limit:
        return text

    order = sorted(range(len(sections)), key=lambda i: (_memory_priority(sections[i][0]), i))
    used = len(preamble) + sum(len(sections[i][0]) + 2 for i in range(len(sections))) + 160
    kept: Dict[int, str] = {}
    for i in order:
        body = sections[i][1]
        room = limit - used
        if len(body) + 2 <= room:
            kept[i] = body
            used += len(body) + 2
        elif room > 300:
            # Partially include rather than skip: a greedy fill would drop the single
            # most valuable section whenever it is the largest, and backfill with
            # lower-priority ones. Priority has to dominate size.
            cut = body[:room - 90]
            kept[i] = cut[:cut.rfind("\n") if "\n" in cut else len(cut)].rstrip() + \
                "\n- _(section truncated to budget — read `.agents/memory.md`)_"
            used = limit
        else:
            break

    out = [preamble] if preamble else []
    for idx, (heading, body) in enumerate(sections):
        out.append(f"{heading}\n{kept[idx]}".rstrip() if idx in kept
                   else f"{heading}\n- _(section trimmed to budget — read `.agents/memory.md`)_")
    dropped = len(sections) - len(kept)
    if dropped:
        out.append(f"_{dropped} of {len(sections)} sections trimmed, lowest-priority first "
                   f"(invariants and gotchas are kept ahead of status)._")
    return "\n\n".join(out)


def resolve_budget(value: Optional[str], default: int) -> int:
    """Accept a raw character count or a preset name; env var sets the session default."""
    raw = value or os.environ.get("AGENT_CTX_BUDGET") or "default"
    if raw == "default":
        return default
    if raw.isdigit():
        return int(raw)
    if raw in BUDGET_PRESETS:
        return BUDGET_PRESETS[raw]
    names = "/".join(["default", *BUDGET_PRESETS])
    raise SystemExit(f"--budget: expected a character count or one of {names}, got {raw!r}")


def cmd_init(args: argparse.Namespace) -> int:
    root = find_repo_root()
    agents_dir = root / ".agents"
    agents_dir.mkdir(exist_ok=True)

    for name, template in (("memory.md", DEFAULT_MEMORY_TEMPLATE), ("decisions.md", DEFAULT_DECISIONS_TEMPLATE)):
        target = agents_dir / name
        if not target.exists():
            target.write_text(template, encoding="utf-8")
            print(f"Created {target.relative_to(root)}")
        else:
            print(f"Already exists: {target.relative_to(root)}")

    act_file = agents_dir / "activity.jsonl"
    if not act_file.exists():
        act_file.touch()
        print(f"Created {act_file.relative_to(root)}")

    map_file = agents_dir / "repo_map.md"
    map_file.write_text(generate_repo_map(root), encoding="utf-8")
    print(f"Generated {map_file.relative_to(root)}")
    print("Initialization complete.")
    return 0


def cmd_map(args: argparse.Namespace) -> int:
    root = find_repo_root()
    map_content = generate_repo_map(root, budget=resolve_budget(args.budget, MAP_BUDGET_DEFAULT))

    if args.stdout:
        print(map_content)
    else:
        agents_dir = root / ".agents"
        agents_dir.mkdir(exist_ok=True)
        map_file = agents_dir / "repo_map.md"
        map_file.write_text(map_content, encoding="utf-8")
        print(f"Updated {map_file.relative_to(root)}")
    return 0


def cmd_log(args: argparse.Namespace) -> int:
    root = find_repo_root()
    agents_dir = root / ".agents"
    agents_dir.mkdir(exist_ok=True)
    act_file = agents_dir / "activity.jsonl"

    files_list = [f.strip() for f in args.files.split(",") if f.strip()] if args.files else []
    record = {
        "timestamp": datetime.datetime.now(datetime.timezone.utc).isoformat(),
        "action": args.action,
        "summary": args.summary,
        "files": files_list,
        "branch": get_git_branch(root),
        "author": os.environ.get("AGENT_NAME", os.environ.get("USER", "agent")),
    }

    with open(act_file, "a", encoding="utf-8") as f:
        f.write(json.dumps(record) + "\n")
    print(f"Logged action '{args.action}' to {act_file.relative_to(root)}")
    print("Reminder: if this introduced a new invariant, gotcha, or architecture decision, update .agents/memory.md or .agents/decisions.md.")
    return 0


def cmd_history(args: argparse.Namespace) -> int:
    root = find_repo_root()
    act_file = root / ".agents" / "activity.jsonl"
    if not act_file.is_file():
        print("No activity recorded yet.")
        return 0

    lines = act_file.read_text(encoding="utf-8", errors="ignore").strip().splitlines()
    if not lines:
        print("No activity recorded yet.")
        return 0

    records = []
    for l in lines:
        try:
            records.append(json.loads(l))
        except Exception:
            continue

    selected = records[-args.limit:] if args.limit > 0 else records
    for r in reversed(selected):
        ts = r.get("timestamp", "")[:19].replace("T", " ")
        files = ", ".join(r.get("files", []))
        print(f"[{ts}] ({r.get('branch') or 'unknown'}) {r.get('action', '')}")
        print(f"  Summary: {r.get('summary', '')}")
        if files:
            print(f"  Files: {files}")
        print()
    return 0


def cmd_dump(args: argparse.Namespace) -> int:
    root = find_repo_root()
    agents_dir = root / ".agents"
    total = resolve_budget(getattr(args, "budget", None), DUMP_TOTAL_BUDGET)
    # Prose stores each get a third; the map takes what is left. Scaling with the
    # total is what makes a larger preset help every section, not just the map.
    prose_budget = total // 3

    out = [f"# Agent Context Snapshot ({root.name})\n"]

    state = get_working_state(root)
    if state:
        out.append("## Working state\n")
        out.append(state)
        out.append("\n---\n")

    mem_file = agents_dir / "memory.md"
    if mem_file.is_file():
        out.append("## Project Memory\n")
        out.append(clip_memory(mem_file.read_text(encoding="utf-8", errors="ignore").strip(), prose_budget))
        out.append("\n---\n")

    dec_file = agents_dir / "decisions.md"
    if dec_file.is_file():
        out.append("## Architecture Decisions\n")
        out.append(clip_decisions(dec_file.read_text(encoding="utf-8", errors="ignore").strip(), prose_budget))
        out.append("\n---\n")

    # Build the activity tail before the map so the map's share is what is genuinely
    # left over — otherwise DUMP_TOTAL_BUDGET would not be a total at all.
    tail: List[str] = []
    act_file = agents_dir / "activity.jsonl"
    if act_file.is_file():
        lines = act_file.read_text(encoding="utf-8", errors="ignore").strip().splitlines()
        if lines:
            tail.append("## Recent Activity\n")
            for l in lines[-5:]:
                try:
                    r = json.loads(l)
                    ts = r.get("timestamp", "")[:10]
                    tail.append(f"- **{ts} [{r.get('action')}]**: {r.get('summary')} (files: {', '.join(r.get('files', [])) or 'none'})")
                except Exception:
                    pass

    spent = sum(len(chunk) for chunk in out) + sum(len(chunk) for chunk in tail)
    out.append("## Structure & Symbol Map (live)\n")
    out.append(generate_repo_map(root, budget=max(DUMP_MAP_MIN_BUDGET, total - spent)).strip())
    out.append("\n---\n")
    out.extend(tail)

    print("\n".join(out))
    return 0


